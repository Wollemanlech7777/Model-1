# Copy to repo-root `.env` and fill locally. Never commit real values.
DATABASE_URL=
GEMINI_API_KEY=
ENVIRONMENT=development
LOG_LEVEL=INFO
CYBERNOTES_CLIENT_ID=
CYBERNOTES_CLIENT_SECRET=
CYBERNOTES_BASE_URL=https://api.cybernotes.it/mtpl/v1
CYBERNOTES_TIMEOUT_SECONDS=20
GEMINI_TIMEOUT_SECONDS=20
# Comma-separated browser origins (no wildcard when credentials enabled)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true
# POST /jobs/policy-review per client IP per minute; 0 disables
RATE_LIMIT_POLICY_REVIEW_PER_MINUTE=60
# Demo reset endpoint; auto-disabled when ENVIRONMENT=production unless forced true
ENABLE_DEMO_RESET=
